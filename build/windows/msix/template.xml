<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="yi-todo"
        Arguments=""
        InstallLocation="C:\Program Files\yi-todo\yi-todo">
    </Installer>
    <PackageInformation
        PackageName="yi-todo"
        PackageDisplayName="yi-todo"
        PublisherName="CN=yi-todo"
        PublisherDisplayName="yi-todo"
        Version="0.0.3.0"
        PackageDescription="Local-first desktop task manager">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.junyiwu.ytodo"
                Description="Local-first desktop task manager"
                DisplayName="yi-todo"
                ExecutableName="yi-todo"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>yi-todo</DisplayName>
            <PublisherDisplayName>yi-todo</PublisherDisplayName>
            <Description>Local-first desktop task manager</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="yi-todo.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
